[Unit]
Description=NYA web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nya
Group=nya
WorkingDirectory=/opt/nya-quick-launch
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/pnpm exec vinext start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
